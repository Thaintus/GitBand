<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.reorder-group">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Styles.Resources>
        <!-- 独立主题隔离 Fluent 的模板状态色，避免悬停时覆盖危险按钮的红色。 -->
        <ControlTheme x:Key="GitBindButtonTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        <Border Name="FocusRing" Margin="-3" CornerRadius="11" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GitBindNavigationItemTheme" TargetType="ListBoxItem">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="NavigationSurface" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Border Name="NavigationMarker" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="Transparent" />
                            <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="HyperlinkButton.project-link">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="HyperlinkButton.project-link TextBlock.project-link-text">
        <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>
    <Style Selector="HyperlinkButton.project-link:pointerover TextBlock.project-link-text">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 统一排版与容器；界面颜色集中通过 App 资源管理。 -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.page-description">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Microsoft YaHei UI, monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BoxShadow" Value="0 2 6 0 #050F1D36" />
    </Style>
    <Style Selector="Border.inset">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.badge-primary">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    </Style>
    <Style Selector="Border.badge-primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Border.badge-success">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    </Style>
    <Style Selector="Border.badge-success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.badge-warning">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>
    <Style Selector="Border.badge-warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.badge-danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>
    <Style Selector="Border.badge-danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Theme" Value="{StaticResource GitBindButtonTheme}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerBorderBrush}" />
    </Style>

    <Style Selector="Button.icon-danger">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.icon-danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#FocusRing">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!-- 导航使用独立模板，消除系统主题对选中色与圆角的覆盖。 -->
    <Style Selector="ListBox.project-groups ListBoxItem">
        <Setter Property="Theme" Value="{StaticResource GitBindNavigationItemTheme}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.project-groups ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
    </Style>
    <Style Selector="ListBox.project-groups ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.project-groups ListBoxItem:selected /template/ Border#NavigationMarker">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.project-groups ListBoxItem:focus-visible /template/ Border#NavigationSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Theme" Value="{StaticResource GitBindNavigationItemTheme}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationMutedBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ Border#NavigationMarker">
        <Setter Property="Background" Value="{DynamicResource NavigationAccentBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:focus-visible /template/ Border#NavigationSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource NavigationAccentBrush}" />
    </Style>
    <Style Selector="Button.sidebar-settings">
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationMutedBrush}" />
    </Style>
    <Style Selector="Button.sidebar-settings:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavigationHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}" />
    </Style>
    <Style Selector="Button.sidebar-settings:pressed, Button.sidebar-settings.active">
        <Setter Property="Background" Value="{DynamicResource NavigationSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}" />
    </Style>
    <Style Selector="Button.sidebar-settings:focus-visible /template/ Border#FocusRing">
        <Setter Property="BorderBrush" Value="{DynamicResource NavigationAccentBrush}" />
    </Style>
    <!-- 项目列表使用较小控件和内边距，提高单屏信息密度。 -->
    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox.compact">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.project-binding">
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!-- 各页面共用线性图标；主要入口保留文字，避免不同操作之间产生歧义。 -->
    <Style Selector="Path.action-glyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Path.action-glyph.pull-glyph">
        <Setter Property="StrokeThickness" Value="1.9" />
    </Style>
    <Style Selector="Button.icon-action">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.icon-action.small">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Button.icon-action.destructive">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.icon-action.destructive:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.pull-action">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Button.pull-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.pull-action:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>
    <Style Selector="Border.project-sidebar">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.group-count">
        <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="Border.project-card:pointerover, Border.list-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.project-group-choice">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox.project-group-choice /template/ PathIcon">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBox.project-group-choice:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.project-group-choice:focus-visible, ComboBox.project-group-choice:dropdownopen">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <!-- 项目工作区：用排版、单层卡片和细分隔线形成层次，避免多层彩色容器。 -->
    <Style Selector="Button.project-entry">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.secondary.project-entry">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondary.project-entry:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="Border.project-searchbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.project-searchbar:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>
    <Style Selector="TextBox.project-search-input">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Border.project-result-count">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,3,4,3" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.project-card">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #040F1D36" />
    </Style>
    <Style Selector="Border.project-repository-icon">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    </Style>
    <Style Selector="TextBlock.project-name">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.project-detail">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- 数据项操作采用同一套轻量尺寸，页头文字按钮和其他页面不受影响。 -->
    <Style Selector=".projects-page Button.icon-action">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector=".projects-page Button.icon-action Path.action-glyph">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="StrokeThickness" Value="1.4" />
    </Style>
    <Style Selector=".projects-page Button.icon-action Path.pull-glyph">
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector=".projects-page Button.icon-action:focus-visible /template/ Border#FocusRing">
        <Setter Property="Margin" Value="-2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <!-- 分组卡片以名称为主；只缩图形，保留 24px 点击区与完整交互反馈。 -->
    <Style Selector=".projects-page ListBox.project-groups Button.icon-action Path.action-glyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="StrokeThickness" Value="1.2" />
    </Style>
    <Style Selector=".projects-page ListBox.project-groups Button.icon-action Path.pull-glyph">
        <Setter Property="StrokeThickness" Value="1.3" />
    </Style>
    <Style Selector=".projects-page ListBox.project-groups TextBlock.project-group-name">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=".projects-page ListBox.project-groups TextBlock.project-group-count">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="Focusable" Value="True" />
    </Style>
    <!-- 拖动状态放在普通卡片样式之后，确保预览背景与描边不会被覆盖。 -->
    <Style Selector="Border.reorder-item.reorder-preview">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    </Style>
</Styles>
